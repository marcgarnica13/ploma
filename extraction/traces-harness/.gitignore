# ---- Secrets & credentials -------------------------------------------------
# Mongo connection parts and any other local env files
**/.env
**/.env.*
!**/.env.example

# ---- Backups / archives ----------------------------------------------------
# One-off bundle of the deprecated src/ git history (kept locally, not tracked)
src-history-backup.bundle
*.bundle

# ---- Large / generated data & results --------------------------------------
# src/ keeps only test fixtures under data/test_data
src/data/*
!src/data/test_data/
!src/data/test_data/**
# Timestamped discovery outputs (hundreds of MB of rendered PDFs/PNGs)
src/results/
src/notebooks/results/
*.xes

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.ipynb_checkpoints/
.venv/
venv/

# ---- LaTeX build artifacts (manuscript/) -----------------------------------
manuscript/*.aux
manuscript/*.bbl
manuscript/*.blg
manuscript/*.log
manuscript/*.out
manuscript/*.toc
manuscript/*.fls
manuscript/*.fdb_latexmk
manuscript/*.synctex.gz
# Build output PDF (regenerated by `make`); source figures fig1-5.pdf are kept
manuscript/samplepaper.pdf

# ---- Claude Code -----------------------------------------------------------
# Per-user / secret-bearing settings stay local; .claude/settings.json is committed
.claude/settings.local.json
.claude/**/*.local.*
# Volatile state written by the harness hooks (not source)
.claude/sessions/
quality_reports/session_logs/
quality_reports/.doi_cache.json

# ---- OS / editor -----------------------------------------------------------
.DS_Store
*.swp
*.code-workspace
